diff --git a/src/signals/change.ts b/src/signals/change.ts
new file mode 100644
index 0000000..6228cb9
--- /dev/null
+++ b/src/signals/change.ts
@@ -0,0 +1,65 @@
+import type { ChangedFile, Evidence, SignalProvider } from "../domain/types.js";
+import { changedLines } from "../git/diff.js";
+import { matchAny } from "../git/glob.js";
+import { isCodeFamily, languageFamily } from "./language.js";
+import { countedFiles, plural, topEvidence } from "./util.js";
+
+/** Error handling, null checks, assertions and precondition helpers: code that rejects bad states. */
+const SAFETY =
+  /\b(catch|except|rescue|finally)\b|\bthrow\b(?!s)|\braise\b|\bassert\b|[!=]==?\s*(null|nil|None|undefined)\b|\b(null|nil|None|undefined)\s*[!=]==?|\bis (not )?None\b|\bcheck(Argument|State|NotNull|Index|ElementIndex|PositionIndex)\s*\(|\brequireNonNull\s*\(|\bValidate\.\w+\s*\(/;
+
+/** Locks, atomics, executors and thread or goroutine primitives (not async/await, which is everywhere in JS). */
+const CONCURRENCY =
+  /\b(synchronized|volatile|ReentrantLock|ReadWriteLock|ReentrantReadWriteLock|StampedLock|Semaphore|CountDownLatch|CyclicBarrier|Phaser|ExecutorService|Executors|ThreadPoolExecutor|ForkJoinPool|CompletableFuture|ConcurrentHashMap|ConcurrentLinkedQueue|BlockingQueue|ThreadLocal|Atomic(Integer|Long|Boolean|Reference)\w*|Mutex|RwLock|RWMutex|WaitGroup|threading|multiprocessing)\b|\bnew Thread\b|\bThread\.(sleep|start|interrupt|yield)\b|\.(wait|notify|notifyAll|lock|unlock|tryLock)\s*\(|\bgo func\b/;
+
+/** A whole-line comment in any of the supported syntaxes; such lines are never counted. */
+const isComment = (text: string): boolean => /^\s*(\/\/|#|\/\*|\*)/.test(text);
+
+/** Non-test code files: the change.* signals read program code only. */
+function codeFiles(files: ChangedFile[], tests: string[]): ChangedFile[] {
+  return files.filter((f) => !f.binary && isCodeFamily(languageFamily(f.path)) && !matchAny(tests, f.path));
+}
+
+/**
+ * "change.safety_removed": log1p of safety lines (SAFETY) deleted with no matching
+ * addition. Per hunk, deleted safety lines minus added ones, so a reworded guard does not count.
+ *
+ * "change.concurrency": 1 when any changed line of non-test code uses a concurrency
+ * primitive (CONCURRENCY), added or deleted.
+ */
+export const changeSignals: SignalProvider = async (ctx) => {
+  const files = codeFiles(countedFiles(ctx), ctx.config.paths.tests);
+  const removed: Evidence[] = [];
+  const concurrency: Evidence[] = [];
+  for (const f of files) {
+    for (const h of f.hunks) {
+      const deleted: Evidence[] = [];
+      let added = 0;
+      for (const { kind, line, text } of changedLines(h)) {
+        if (isComment(text)) continue;
+        if (CONCURRENCY.test(text)) concurrency.push({ file: f.path, line, detail: `${kind} ${text.trim().slice(0, 100)}` });
+        if (!SAFETY.test(text)) continue;
+        if (kind === "-") deleted.push({ file: f.path, line, detail: `- ${text.trim().slice(0, 100)}` });
+        else added++;
+      }
+      removed.push(...deleted.slice(0, Math.max(0, deleted.length - added)));
+    }
+  }
+
+  return [
+    {
+      id: "change.safety_removed",
+      value: Math.log1p(removed.length),
+      status: "observed",
+      summary: removed.length > 0 ? `${plural(removed.length, "error-handling or guard line")} deleted without a replacement` : "no error handling or guard removed",
+      evidence: topEvidence(removed),
+    },
+    {
+      id: "change.concurrency",
+      value: concurrency.length > 0 ? 1 : 0,
+      status: "observed",
+      summary: concurrency.length > 0 ? `${plural(concurrency.length, "changed line")} use concurrency primitives` : "no concurrency primitive changed",
+      evidence: topEvidence(concurrency),
+    },
+  ];
+};
