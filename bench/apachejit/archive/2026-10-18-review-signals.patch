   repo.commit(change, "change");
   const signals = await testsSignals(await contextFor(repo, "HEAD~1"));
-  expect(signals.map((s) => s.id)).toEqual(["tests.missing", "tests.deleted"]);
+  expect(signals.map((s) => s.id)).toEqual(["tests.missing", "tests.deleted", "tests.weakened"]);
   return signals[0]!;
 }
 
@@ -83,6 +83,47 @@ describe("tests.deleted", () => {
   });
 });
 
+/** tests.weakened for a change on top of `base`. */
+async function weakened(repo: TestRepo, base: Record<string, string>, change: Record<string, string | null>) {
+  repo.commit({ "seed.txt": "s\n", ...base }, "init");
+  repo.commit(change, "change");
+  return (await testsSignals(await contextFor(repo, "HEAD~1")))[2]!;
+}
+
+const JAVA_TEST = ["class ATest {", "  @Test", "  void f() {", "    int x = a.f();", "    assertEquals(1, x);", "    assertTrue(a.ok());", "  }", "}", ""].join("\n");
+
+describe("tests.weakened", () => {
+  let repo: TestRepo;
+  afterEach(() => repo?.cleanup());
+
+  it("is 1 when test files lose more assertions than they gain, naming the file", async () => {
+    repo = makeRepo();
+    const s = await weakened(repo, { "src/test/java/ATest.java": JAVA_TEST }, { "src/test/java/ATest.java": JAVA_TEST.replace("    assertTrue(a.ok());\n", "") });
+    expect(s).toMatchObject({ id: "tests.weakened", value: 1, status: "observed" });
+    expect(s.evidence.map((e) => e.file)).toEqual(["src/test/java/ATest.java"]);
+    expect(s.summary).toMatch(/1 assertion/);
+  });
+
+  it("is 1 when a test is disabled", async () => {
+    repo = makeRepo();
+    const s = await weakened(repo, { "src/test/java/ATest.java": JAVA_TEST }, { "src/test/java/ATest.java": JAVA_TEST.replace("  @Test\n", "  @Test\n  @Ignore\n") });
+    expect(s.value).toBe(1);
+    expect(s.summary).toMatch(/skip/);
+  });
+
+  it("is 0 when assertions are rewritten one for one, or only added", async () => {
+    repo = makeRepo();
+    const rewritten = JAVA_TEST.replace("assertEquals(1, x);", "assertThat(x).isEqualTo(1);");
+    expect((await weakened(repo, { "src/test/java/ATest.java": JAVA_TEST }, { "src/test/java/ATest.java": rewritten })).value).toBe(0);
+  });
+
+  it("ignores assertions removed from non-test files", async () => {
+    repo = makeRepo();
+    const s = await weakened(repo, { "src/A.java": "assert x > 0;\nf();\n" }, { "src/A.java": "f();\n" });
+    expect(s).toMatchObject({ value: 0, evidence: [] });
+  });
+});
+
 describe("testsSignals", () => {
   let repo: TestRepo;
   afterEach(() => repo?.cleanup());
