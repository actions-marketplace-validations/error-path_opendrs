diff --git a/src/signals/tests.ts b/src/signals/tests.ts
index 7c1a6ae..804a265 100644
--- a/src/signals/tests.ts
+++ b/src/signals/tests.ts
@@ -1,4 +1,5 @@
-import type { ChangedFile, SignalProvider } from "../domain/types.js";
+import type { ChangedFile, Evidence, SignalProvider } from "../domain/types.js";
+import { changedLines } from "../git/diff.js";
 import { matchAny } from "../git/glob.js";
 import { isCodeFamily, languageFamily } from "./language.js";
 import { countedFiles, plural, topEvidence } from "./util.js";
@@ -9,6 +10,12 @@ const EXPECTED_TEST_SHARE = 0.3;
 /** Net deleted test lines (deleted − added) at which `tests.deleted` fires. */
 const NET_TEST_DELETION = 10;
 
+/** An assertion call or statement in a test (JUnit, AssertJ, Jest, Mockito, pytest, Go testify). */
+const ASSERTION = /\bassert\w*\s*\(|\bassert\s|\bexpect\s*\(|\bverify\s*\(|\.should\b/;
+
+/** A marker that disables a test. */
+const SKIP = /@Ignore\b|@Disabled\b|\benabled\s*=\s*false\b|\bpytest\.mark\.skip|@unittest\.skip|\b(xit|xdescribe|xtest)\s*\(|\b(it|test|describe)\.skip\s*\(|\bt\.Skip(Now)?\s*\(/;
+
 /**
  * Spec §4 "tests.missing": 1 when source changed and no test lines were added; otherwise
  * max(0, 1 − addedTestLines / (0.3 · sourceLines)), so a token test edit barely helps. Deleted test
@@ -49,6 +56,24 @@ export const testsSignals: SignalProvider = async (ctx) => {
     netDeleted >= NET_TEST_DELETION && `${plural(netDeleted, "test line")} more deleted than added`,
   ].filter(Boolean);
 
+  // tests.weakened: more assertion lines deleted than added across the test files, or a test disabled.
+  let netAsserts = 0;
+  const lost: Evidence[] = [];
+  const skips: Evidence[] = [];
+  for (const f of tests) {
+    let fileNet = 0;
+    for (const h of f.hunks) {
+      for (const { kind, line, text } of changedLines(h)) {
+        if (ASSERTION.test(text)) fileNet += kind === "-" ? 1 : -1;
+        if (kind === "+" && SKIP.test(text)) skips.push({ file: f.path, line, detail: `skip marker added: ${text.trim().slice(0, 100)}` });
+      }
+    }
+    netAsserts += fileNet;
+    if (fileNet > 0) lost.push({ file: f.path, detail: `${plural(fileNet, "assertion line")} more deleted than added` });
+  }
+  const weakened = netAsserts > 0 || skips.length > 0;
+  const weakenedSummary = [netAsserts > 0 && `${plural(netAsserts, "assertion line")} more deleted than added`, skips.length > 0 && `${plural(skips.length, "skip marker")} added`].filter(Boolean);
+
   return [
     {
       id: "tests.missing",
@@ -73,5 +98,12 @@ export const testsSignals: SignalProvider = async (ctx) => {
           ])
         : [],
     },
+    {
+      id: "tests.weakened",
+      value: weakened ? 1 : 0,
+      status: "observed",
+      summary: weakened ? weakenedSummary.join("; ") : "no assertion removed or test disabled",
+      evidence: weakened ? topEvidence([...(netAsserts > 0 ? lost : []), ...skips]) : [],
+    },
   ];
 };
diff --git a/tests/signals/change.test.ts b/tests/signals/change.test.ts
new file mode 100644
index 0000000..b0a51a6
--- /dev/null
+++ b/tests/signals/change.test.ts
@@ -0,0 +1,92 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { changeSignals } from "../../src/signals/change.js";
+import { makeRepo, type TestRepo } from "../helpers/repo.js";
+import { byId, contextFor } from "./context.js";
+
+async function signals(repo: TestRepo, base: Record<string, string>, change: Record<string, string | null>) {
+  repo.commit({ "seed.txt": "s\n", ...base }, "init");
+  repo.commit(change, "change");
+  return changeSignals(await contextFor(repo, "HEAD~1"));
+}
+
+const GUARDED = [
+  "class A {",
+  "  int f(String s) {",
+  "    if (s == null) throw new IllegalArgumentException();",
+  "    Preconditions.checkArgument(s.length() > 0);",
+  "    try {",
+  "      return g(s);",
+  "    } catch (IOException e) {",
+  "      return -1;",
+  "    }",
+  "  }",
+  "}",
+  "",
+].join("\n");
+
+describe("change.safety_removed", () => {
+  let repo: TestRepo;
+  afterEach(() => repo?.cleanup());
+
+  it("counts deleted guards and error handling with no replacement", async () => {
+    repo = makeRepo();
+    const bare = ["class A {", "  int f(String s) {", "    return g(s);", "  }", "}", ""].join("\n");
+    const s = byId(await signals(repo, { "src/A.java": GUARDED }, { "src/A.java": bare }), "change.safety_removed");
+    // the null check with its throw, checkArgument, and the catch
+    expect(s).toMatchObject({ value: Math.log1p(3), status: "observed" });
+    expect(s.evidence.map((e) => e.file)).toEqual(["src/A.java", "src/A.java", "src/A.java"]);
+  });
+
+  it("is 0 when a guard is only reworded in the same hunk", async () => {
+    repo = makeRepo();
+    const reworded = GUARDED.replace("if (s == null) throw new IllegalArgumentException();", "if (s == null) throw new NullPointerException(\"s\");");
+    const s = byId(await signals(repo, { "src/A.java": GUARDED }, { "src/A.java": reworded }), "change.safety_removed");
+    expect(s.value).toBe(0);
+  });
+
+  it("ignores comments, test files and non-code files", async () => {
+    repo = makeRepo();
+    const s = byId(
+      await signals(
+        repo,
+        { "src/a.ts": "// throw if x == null\nx();\n", "src/a.test.ts": "assert(x != null);\n", "conf.yml": "catch: true\n" },
+        { "src/a.ts": "x();\n", "src/a.test.ts": "", "conf.yml": "" },
+      ),
+      "change.safety_removed",
+    );
+    expect(s.value).toBe(0);
+  });
+});
+
+describe("change.concurrency", () => {
+  let repo: TestRepo;
+  afterEach(() => repo?.cleanup());
+
+  it("is 1 when a changed code line uses a concurrency primitive", async () => {
+    repo = makeRepo();
+    const s = byId(
+      await signals(repo, { "src/C.java": "class C {\n  int n;\n}\n" }, { "src/C.java": "class C {\n  private final AtomicInteger n = new AtomicInteger();\n}\n" }),
+      "change.concurrency",
+    );
+    expect(s).toMatchObject({ value: 1, status: "observed" });
+    expect(s.evidence[0]).toMatchObject({ file: "src/C.java", line: 2 });
+  });
+
+  it("sees a removed synchronized block", async () => {
+    repo = makeRepo();
+    const s = byId(
+      await signals(repo, { "src/C.java": "void f() {\n  synchronized (lock) {\n    n++;\n  }\n}\n" }, { "src/C.java": "void f() {\n  n++;\n}\n" }),
+      "change.concurrency",
+    );
+    expect(s.value).toBe(1);
+  });
+
+  it("is 0 for plain code, comments and docs", async () => {
+    repo = makeRepo();
+    const s = byId(
+      await signals(repo, {}, { "src/a.go": "// uses a sync.Mutex upstream\nx := 1\n", "docs/threads.md": "synchronized volatile\n" }),
+      "change.concurrency",
+    );
+    expect(s).toMatchObject({ value: 0, evidence: [] });
+  });
+});
