{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "tests", "bench"],
  "exclude": ["bench/**/run.ts", "bench/**/llm.ts", "bench/**/fit-experiment.ts", "bench/**/judge-sim.ts", "bench/**/coupling-experiment.ts", "bench/**/captain-lift-experiment.ts"]
}
