{
  "name": "opendrs",
  "version": "0.1.0",
  "description": "Open Diff Risk Score: a calibrated 0-1 risk score for every pull request, for risk-based auto-approval.",
  "type": "module",
  "license": "MIT",
  "author": "error-path",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/error-path/opendrs.git"
  },
  "keywords": [
    "code-review",
    "risk",
    "diff",
    "pull-request",
    "auto-merge",
    "blast-radius",
    "defect-prediction",
    "mcp",
    "github-action"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opendrs": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build:action": "esbuild src/action/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=action/dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
